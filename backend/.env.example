APP_NAME=Multimodal RAG API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

OPENAI_API_KEY=change-me
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.1

PINECONE_API_KEY=change-me
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=rag-multimodal
PINECONE_DIMENSION=3072
PINECONE_METRIC=cosine
PINECONE_TOP_K=10

DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ragdb
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

ALLOWED_ORIGINS=["http://localhost:5173"]

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=["pdf","docx","txt","png","jpg","jpeg","csv","xlsx"]
UPLOAD_DIR=/tmp/uploads

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=60

AWS_REGION=us-east-1
